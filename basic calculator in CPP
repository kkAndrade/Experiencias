//CALCULADORA COM STRUCT, FUNCTION E REFERÊNCIA
#include <iostream>

using namespace std;

struct valores{
    int escolha;
    float valor1;
    float valor2;
};


void calc(valores &calculadora){
    cout << "Digite um dos valores a seguir:\n(1)adicao, (2)subtracao, (3)multiplicacao e (4)divisao: " << "\n";
    cin >> calculadora.escolha;
    cout << "Digite um numero: " << "\n";
    cin >> calculadora.valor1;
    cout << "Digite outro numero" << "\n";
    cin >> calculadora.valor2;
}

int retorna(valores &calculadora, int decisao){
    decisao = calculadora.escolha;
    return decisao;
    
}

void adicao(valores &calculadora){
    if (calculadora.escolha == 1) {
        cout << "O resultado da operacao e: "<< calculadora.valor1 + calculadora.valor2;        
    }
}

void subtracao(valores &calculadora){
    if (calculadora.escolha == 2) {
        cout << "O resultado da operacao e: " << calculadora.valor1 - calculadora.valor2;
    }
}

void multiplicacao(valores &calculadora){
    if (calculadora.escolha == 3) {
        cout << "O resultado da operacao e: " << calculadora.valor1 * calculadora.valor2;
    }
}

void divisao(valores &calculadora){
    if (calculadora.escolha == 4) {
        cout << "O resultado da operacao e: " << calculadora.valor1 / calculadora.valor2;
    }
}

int main() {
    valores calculos;
    calc(calculos);

    int decisao_main = retorna(calculos, calculos.escolha);

    if (decisao_main == 1){
        adicao(calculos);
    }

    else if(decisao_main){
        subtracao(calculos);    
    }
    
    else if(decisao_main){
         multiplicacao(calculos);
    }
    
    else{
        divisao(calculos);
    }
    
    return 0;
}
